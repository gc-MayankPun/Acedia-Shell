{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto", 
    "source": "\"$(~/.config/fastfetch/random_logo.sh)\"",  
    "height": 20,
    "width": 40,
    "padding": {
      "top": 1,
      "left": 5,
      "right": 10
    }
  },
  "display": {
    "separator": "",
    "color": { "keys": "blue", "title": "magenta", "output": "white" }
  },
  "modules": [
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": "╭────────────────────── Software ────────────────────────╮"
    },
    {
      "type": "os",
      "key": "   ",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "  󰒓 ",
      "format": "{2}"
    },
    {
      "type": "shell",
      "key": "  󰆍 "
    },
    {
      "type": "packages",
      "key": "  󰏗 "
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "╭────────────────────── Desktop ─────────────────────────╮"
    },
    {
      "type": "wm",
      "key": "  󰘔 "
    },
    {
      "type": "theme",
      "key": "  󰉼 "
    },
    {
      "type": "terminal",
      "key": "   "
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "╭──────────────────── Uptime / DT ───────────────────────╮"
    },
    {
      "type": "uptime",
      "key": "  Uptime: "
    },
    {
      "type": "datetime",
      "key": "  DateTime: "
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}